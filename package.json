{
  "name": "fuckclaw",
  "version": "1.0.0",
  "description": "FuckClaw - Personal AI Operating System",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "lint": "pnpm run build",
    "clean": "pnpm -r run clean",
    "boot": "node scripts/boot.js",
    "fuckclaw": "node packages/cli/dist/bin.js",
    "demo:m3": "node scripts/milestone3-demo.js",
    "demo:m8": "node scripts/milestone8-demo.js",
    "demo:multi-agent": "node scripts/demo-multi-agent.js",
    "demo:self-improvement": "node scripts/demo-self-improvement.js",
    "demo:e2e": "node scripts/full-architecture-e2e.js"
  },
  "dependencies": {
    "@fuckclaw/cli": "workspace:*",
    "@fuckclaw/config": "workspace:*",
    "@fuckclaw/core": "workspace:*",
    "@fuckclaw/event-bus": "workspace:*",
    "@fuckclaw/kernel": "workspace:*",
    "@fuckclaw/knowledge-graph": "workspace:*",
    "@fuckclaw/llm-router": "workspace:*",
    "@fuckclaw/multi-agent": "workspace:*",
    "@fuckclaw/observability": "workspace:*",
    "@fuckclaw/persistence": "workspace:*",
    "@fuckclaw/reasoning": "workspace:*",
    "@fuckclaw/self-improvement": "workspace:*",
    "@fuckclaw/skills": "workspace:*",
    "@fuckclaw/tool-runtime": "workspace:*",
    "@fuckclaw/workspace": "workspace:*",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "packageManager": "pnpm@9.0.0"
}
